{
  "manifest_version": 3,
  "name": "Tabbit - Automatic Tab Grouping",
  "version": "1.1.0",
  "description": "Automatic tab grouping — new tabs join the tab that opened them. Configurable naming, group size limits, custom rules, blacklist.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tabbit@thevirtualpanda",
      "strict_min_version": "139.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["tabs", "tabGroups", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tabbit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "homepage_url": "https://github.com/iUngerTime/Tabbit-Broswer-Extension"
}
