{
  "manifest_version": 3,
  "name": "Tabbit - Automatic Tab Grouping",
  "version": "1.1.0",
  "description": "Automatic tab grouping — groups new tabs with the tab that opened them. Configurable naming, max group size, custom rules, blacklist, and more.",
  "minimum_chrome_version": "89",
  "permissions": ["tabs", "tabGroups", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tabbit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "homepage_url": "https://github.com/iUngerTime/Tabbit-Firefox-Extension"
}
